# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
hs_err_pid*

# ---------------------------------
# Terraform Core Files
# ---------------------------------
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform plan files (NEVER commit plans)
*.tfplan
*.plan

# Local Terraform directories
.terraform/
.terraform.lock.hcl

# Override files (local-only configs)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# ---------------------------------
# Environment-specific state (safety layer)
# ---------------------------------
# (even if remote backend is used, avoid accidental commits)
terraform/environments/**/terraform.tfstate
terraform/environments/**/terraform.tfstate.backup

# ---------------------------------
# Local variable files (can contain secrets)
# ---------------------------------
*.tfvars
*.tfvars.json
terraform.tfvars
terraform.tfvars.json
!*.tfvars.example

# But allow example files
!example.tfvars
!*.example.tfvars

# ---------------------------------
# Logs & debugging
# ---------------------------------
*.log
terraform.log*

# ---------------------------------
# Module temporary artifacts
# ---------------------------------
**/.terraform/
**/terraform.tfstate*
**/.terraform.lock.hcl

# ---------------------------------
# IDE / Editor noise
# ---------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------
# OS files
# ---------------------------------
.DS_Store
ehthumbs.db

# ---------------------------------
# Sensitive files (extra safety)
# ---------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx